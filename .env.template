# Azure AI Foundry Configuration
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_RESOURCE_GROUP=your_resource_group_name_here
PROJECT_NAME=your_project_name_here
PROJECT_ENDPOINT=https://your-project.cognitiveservices.azure.com/
# Often the same as PROJECT_ENDPOINT, used in some SDK samples
AZURE_AI_PROJECT_ENDPOINT=https://your-project.cognitiveservices.azure.com/
PROJECT_CONNECTION_STRING=your_connection_string_here

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-05-01-preview
MODEL_DEPLOYMENT_NAME=gpt-4o
# Alias often used in Agent Framework samples
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o
# Reasoning model (e.g., o1, o3-mini)
R_MODEL_DEPLOYMENT_NAME=o3-mini
EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002

# Azure AI Search (optional)
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_API_KEY=your_search_api_key_here
AZURE_AI_SEARCH_INDEX_NAME=your_index_name

# Azure Storage (for file operations)
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string_here
AZURE_BLOB_URI=https://yourstorageaccount.blob.core.windows.net/container/file.pdf

# Bing Search (optional)
BING_SEARCH_API_KEY=your_bing_search_api_key_here
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/

# Microsoft Fabric (optional)
FABRIC_CONNECTION_ID=your_fabric_connection_id_here

# Azure Functions (optional)
AZURE_FUNCTION_ENDPOINT=https://your-function-app.azurewebsites.net

# SharePoint (optional)
SHAREPOINT_CONNECTION_NAME=sharepoint
SHAREPOINT_RESOURCE_NAME=https://yourtenant.sharepoint.com/sites/yoursite

# MCP Server Configuration
# For local development: http://localhost:3000
# For production: https://your-mcp-server.azurecontainerapps.io
MCP_SERVER_URL=http://localhost:3000
MCP_SERVER_AUTH_TOKEN=your_mcp_auth_token_here

# Logging and Monitoring
LOG_LEVEL=INFO
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
APPLICATIONINSIGHTS_CONNECTION_STRING=your_app_insights_connection_string_here

# Development settings
DEBUG=false
ENVIRONMENT=development
